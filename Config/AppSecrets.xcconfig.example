// Copy this file to Config/AppSecrets.local.xcconfig and fill in production
// values. Config/AppSecrets.local.xcconfig is ignored by git and is included
// by the checked-in Config/AppSecrets.xcconfig.
//
// App-facing keys here are compiled into the iOS app. Do not put service-role
// keys, private API keys, or webhook secrets in this file.

// Configure Apple Team ID and signing in Xcode.

// For URL values, keep the https:/$()/ form. Xcode expands it to https://
// while avoiding xcconfig comment parsing.
SUPABASE_URL = https:/$()/jkncpveupvozsmbbkvgq.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_YOUR_PUBLIC_KEY

GOOGLE_IOS_CLIENT_ID = YOUR_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID = YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_GOOGLE_IOS_CLIENT_ID

REVENUECAT_API_KEY = appl_YOUR_REVENUECAT_IOS_SDK_KEY

POSTHOG_API_KEY = phc_YOUR_POSTHOG_PROJECT_API_KEY
POSTHOG_HOST = https:/$()/us.i.posthog.com
