// Checked-in base build settings for app-facing configuration.
//
// Do not put service-role keys, private API keys, webhook secrets, or App Store
// Connect keys here. Local production values belong in AppSecrets.local.xcconfig.
//
// Xcode signing/team values are intentionally not included here.

// For URL values, keep the https:/$()/ form. Xcode expands it to https://
// while avoiding xcconfig comment parsing.
SUPABASE_URL = https:/$()/jkncpveupvozsmbbkvgq.supabase.co
SUPABASE_PUBLISHABLE_KEY =

GOOGLE_IOS_CLIENT_ID = YOUR_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID = YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_GOOGLE_IOS_CLIENT_ID

REVENUECAT_API_KEY =

POSTHOG_API_KEY =
POSTHOG_HOST = https:/$()/us.i.posthog.com

// Optional local overrides. This file is ignored by git.
#include? "AppSecrets.local.xcconfig"
